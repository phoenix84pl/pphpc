<?php
// pphpc/views/error.phtml

// Oczekujemy zmiennej $errorCode przekazywanej z miejsca wywołania (Router lub Bootstrap)
$code = $errorCode ?? http_response_code() ?: 500;

// Słownik błędów
$errorMessages = [
    400 => ['title' => 'Bad Request', 'description' => 'Your request could not be understood by the server.'],
    401 => ['title' => 'Unauthorized', 'description' => 'You must log in to access this page.'],
    403 => ['title' => 'Forbidden', 'description' => 'You do not have permission to view this resource.'],
    404 => ['title' => 'Page Not Found', 'description' => 'Sorry, but the page you are looking for does not exist.'],
    500 => ['title' => 'Internal Server Error', 'description' => 'An unexpected problem occurred on the server. Administrators have been notified.'],
    502 => ['title' => 'Bad Gateway', 'description' => 'The server, while acting as a gateway, received an invalid response from the upstream server.'],
    503 => ['title' => 'Service Unavailable', 'description' => 'The server is currently overloaded or under maintenance. Please try again later.'],
];

// Domyślne wartości, jeśli kodu nie ma w słowniku
$errorTitle = $errorMessages[$code]['title'] ?? 'An Error Occurred';
$errorDescription = $errorMessages[$code]['description'] ?? 'Sorry, something went wrong.';

// Pobieranie ścieżki do logo
$logoPath = $_ENV['META_TEXTICON'] ?? getenv('META_TEXTICON') ?: '';
?>
