    401 => ['title' => 'Brak autoryzacji', 'description' => 'Musisz się zalogować, aby uzyskać dostęp do tej strony.'],
    403 => ['title' => 'Odmowa dostępu', 'description' => 'Nie masz uprawnień do przeglądania tego zasobu.'],
    404 => ['title' => 'Strona nie znaleziona', 'description' => 'Przepraszamy, ale strona, której szukasz, nie istnieje.'],
    500 => ['title' => 'Wewnętrzny błąd serwera', 'description' => 'Wystąpił nieoczekiwany problem z serwerem. Administratorzy zostali powiadomieni.'],
    502 => ['title' => 'Błędna brama', 'description' => 'Serwer, działając jako brama, otrzymał nieprawidłową odpowiedź od serwera nadrzędnego.'],
    503 => ['title' => 'Usługa niedostępna', 'description' => 'Serwer jest obecnie przeciążony lub w trakcie konserwacji. Spróbuj ponownie później.'],
